# =============================================
# Coral Payroll - Environment Variables Example
# =============================================
# Copy this file to .env and fill in your real values
# Never commit .env to GitHub!

# Django Settings
DEBUG=True
SECRET_KEY=your-super-long-random-secret-key-here-change-this-in-production-1234567890abcdef

# PostgreSQL Database (Linode)
DB_NAME=db_coralaccounting
DB_USER=coral_payroll
DB_PASSWORD=YourVeryStrongPasswordHere2026!
DB_HOST=your-linode-server-ip-address
DB_PORT=5432

# Optional - Future features
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Timezone (Florida)
TIME_ZONE=America/New_York